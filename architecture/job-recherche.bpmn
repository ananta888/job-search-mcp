<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_JobRecherche"
  targetNamespace="https://github.com/ananta888/job-search-mcp/architecture">
  <bpmn:collaboration id="Collaboration_JobRecherche">
    <bpmn:participant
      id="Participant_JobSearch"
      name="Job Search MCP"
      processRef="Process_JobRecherche" />
  </bpmn:collaboration>

  <bpmn:process id="Process_JobRecherche" name="Job-Recherche" isExecutable="false">
    <bpmn:laneSet id="LaneSet_JobRecherche">
      <bpmn:lane id="Lane_User" name="Nutzer / OpenCode">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Criteria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowErrors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvalidProfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoSource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MCP" name="Job Search MCP">
        <bpmn:flowNodeRef>Task_ValidateProfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProfileValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectSources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LoginNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LoginMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareRequests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aggregate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SourceSuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Portals" name="Externe Portale">
        <bpmn:flowNodeRef>Task_QueryPortals</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Request" name="Recherche angefordert">
      <bpmn:outgoing>Flow_Start_Criteria</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Criteria" name="Suchkriterien festlegen">
      <bpmn:incoming>Flow_Start_Criteria</bpmn:incoming>
      <bpmn:outgoing>Flow_Criteria_Validate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ValidateProfile" name="Profil laden und validieren">
      <bpmn:incoming>Flow_Criteria_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_ProfileValid</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway
      id="Gateway_ProfileValid"
      name="Profil gültig?"
      default="Flow_Profile_Invalid">
      <bpmn:incoming>Flow_Validate_ProfileValid</bpmn:incoming>
      <bpmn:outgoing>Flow_Profile_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Profile_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_InvalidProfile" name="Profil ungültig">
      <bpmn:incoming>Flow_Profile_Invalid</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_SelectSources" name="Aktive Quellen auswählen">
      <bpmn:incoming>Flow_Profile_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_LoginNeeded</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway
      id="Gateway_LoginNeeded"
      name="Login erforderlich?"
      default="Flow_Login_NotNeeded">
      <bpmn:incoming>Flow_Select_LoginNeeded</bpmn:incoming>
      <bpmn:outgoing>Flow_Login_Needed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Login_NotNeeded</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Login" name="Sichtbar einloggen und 2FA bestätigen">
      <bpmn:documentation>Captchas, 2FA und Zugriffsschutz bleiben vollständig unter Kontrolle des Nutzers.</bpmn:documentation>
      <bpmn:incoming>Flow_Login_Needed</bpmn:incoming>
      <bpmn:outgoing>Flow_Login_SaveSession</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_SaveSession" name="Browserzustand speichern">
      <bpmn:incoming>Flow_Login_SaveSession</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveSession_Merge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_LoginMerge" name="Loginpfade zusammenführen">
      <bpmn:incoming>Flow_Login_NotNeeded</bpmn:incoming>
      <bpmn:incoming>Flow_SaveSession_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Prepare</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_PrepareRequests" name="Anfragen und Policy prüfen">
      <bpmn:incoming>Flow_Merge_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Query</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_QueryPortals" name="API, RSS oder Browser-Suche je Quelle">
      <bpmn:documentation>Die ausgewählten Quellen werden nacheinander verarbeitet. Ein Fehler einer Quelle beendet die übrigen Abfragen nicht.</bpmn:documentation>
      <bpmn:incoming>Flow_Prepare_Query</bpmn:incoming>
      <bpmn:outgoing>Flow_Query_Aggregate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Aggregate" name="Treffer normalisieren und Fehler isolieren">
      <bpmn:incoming>Flow_Query_Aggregate</bpmn:incoming>
      <bpmn:outgoing>Flow_Aggregate_SourceSuccessful</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway
      id="Gateway_SourceSuccessful"
      name="Mindestens eine Quelle erfolgreich?"
      default="Flow_Source_None">
      <bpmn:incoming>Flow_Aggregate_SourceSuccessful</bpmn:incoming>
      <bpmn:outgoing>Flow_Source_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Source_None</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ShowErrors" name="Quellenfehler prüfen">
      <bpmn:incoming>Flow_Source_None</bpmn:incoming>
      <bpmn:outgoing>Flow_Errors_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_NoSource" name="Keine Quelle erfolgreich">
      <bpmn:incoming>Flow_Errors_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:businessRuleTask id="Task_Score" name="Angebote gegen Profil bewerten">
      <bpmn:incoming>Flow_Source_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_Score_Report</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_Report" name="Markdown-Bericht erzeugen">
      <bpmn:incoming>Flow_Score_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_Report_Review</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Review" name="Matches und Bericht prüfen">
      <bpmn:incoming>Flow_Report_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Success" name="Recherche abgeschlossen">
      <bpmn:incoming>Flow_Review_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Criteria" sourceRef="Start_Request" targetRef="Task_Criteria" />
    <bpmn:sequenceFlow id="Flow_Criteria_Validate" sourceRef="Task_Criteria" targetRef="Task_ValidateProfile" />
    <bpmn:sequenceFlow id="Flow_Validate_ProfileValid" sourceRef="Task_ValidateProfile" targetRef="Gateway_ProfileValid" />
    <bpmn:sequenceFlow id="Flow_Profile_Valid" name="Ja" sourceRef="Gateway_ProfileValid" targetRef="Task_SelectSources" />
    <bpmn:sequenceFlow id="Flow_Profile_Invalid" name="Nein" sourceRef="Gateway_ProfileValid" targetRef="End_InvalidProfile" />
    <bpmn:sequenceFlow id="Flow_Select_LoginNeeded" sourceRef="Task_SelectSources" targetRef="Gateway_LoginNeeded" />
    <bpmn:sequenceFlow id="Flow_Login_Needed" name="Ja" sourceRef="Gateway_LoginNeeded" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_Login_NotNeeded" name="Nein" sourceRef="Gateway_LoginNeeded" targetRef="Gateway_LoginMerge" />
    <bpmn:sequenceFlow id="Flow_Login_SaveSession" sourceRef="Task_Login" targetRef="Task_SaveSession" />
    <bpmn:sequenceFlow id="Flow_SaveSession_Merge" sourceRef="Task_SaveSession" targetRef="Gateway_LoginMerge" />
    <bpmn:sequenceFlow id="Flow_Merge_Prepare" sourceRef="Gateway_LoginMerge" targetRef="Task_PrepareRequests" />
    <bpmn:sequenceFlow id="Flow_Prepare_Query" sourceRef="Task_PrepareRequests" targetRef="Task_QueryPortals" />
    <bpmn:sequenceFlow id="Flow_Query_Aggregate" sourceRef="Task_QueryPortals" targetRef="Task_Aggregate" />
    <bpmn:sequenceFlow id="Flow_Aggregate_SourceSuccessful" sourceRef="Task_Aggregate" targetRef="Gateway_SourceSuccessful" />
    <bpmn:sequenceFlow id="Flow_Source_Success" name="Ja" sourceRef="Gateway_SourceSuccessful" targetRef="Task_Score" />
    <bpmn:sequenceFlow id="Flow_Source_None" name="Nein" sourceRef="Gateway_SourceSuccessful" targetRef="Task_ShowErrors" />
    <bpmn:sequenceFlow id="Flow_Errors_End" sourceRef="Task_ShowErrors" targetRef="End_NoSource" />
    <bpmn:sequenceFlow id="Flow_Score_Report" sourceRef="Task_Score" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="Flow_Report_Review" sourceRef="Task_Report" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="Task_Review" targetRef="End_Success" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_JobRecherche">
    <bpmndi:BPMNPlane id="BPMNPlane_JobRecherche" bpmnElement="Collaboration_JobRecherche">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_JobSearch" isHorizontal="true">
        <dc:Bounds x="80" y="60" width="2740" height="700" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_User" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="110" y="60" width="2710" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_MCP" bpmnElement="Lane_MCP" isHorizontal="true">
        <dc:Bounds x="110" y="260" width="2710" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Portals" bpmnElement="Lane_Portals" isHorizontal="true">
        <dc:Bounds x="110" y="560" width="2710" height="200" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start_Request">
        <dc:Bounds x="170" y="140" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="135" y="180" width="106" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Criteria" bpmnElement="Task_Criteria">
        <dc:Bounds x="250" y="115" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Task_ValidateProfile">
        <dc:Bounds x="420" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ProfileValid" bpmnElement="Gateway_ProfileValid" isMarkerVisible="true">
        <dc:Bounds x="590" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="573" y="430" width="84" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InvalidEnd" bpmnElement="End_InvalidProfile">
        <dc:Bounds x="597" y="205" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="570" y="175" width="90" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Select" bpmnElement="Task_SelectSources">
        <dc:Bounds x="700" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LoginNeeded" bpmnElement="Gateway_LoginNeeded" isMarkerVisible="true">
        <dc:Bounds x="870" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="850" y="430" width="90" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Login" bpmnElement="Task_Login">
        <dc:Bounds x="965" y="115" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SaveSession" bpmnElement="Task_SaveSession">
        <dc:Bounds x="1110" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LoginMerge" bpmnElement="Gateway_LoginMerge" isMarkerVisible="true">
        <dc:Bounds x="1260" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Prepare" bpmnElement="Task_PrepareRequests">
        <dc:Bounds x="1360" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Query" bpmnElement="Task_QueryPortals">
        <dc:Bounds x="1530" y="620" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Aggregate" bpmnElement="Task_Aggregate">
        <dc:Bounds x="1700" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SourceSuccessful" bpmnElement="Gateway_SourceSuccessful" isMarkerVisible="true">
        <dc:Bounds x="1870" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1840" y="430" width="110" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ShowErrors" bpmnElement="Task_ShowErrors">
        <dc:Bounds x="1970" y="115" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NoSourceEnd" bpmnElement="End_NoSource">
        <dc:Bounds x="2150" y="140" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2115" y="180" width="106" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Score" bpmnElement="Task_Score">
        <dc:Bounds x="1980" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Report" bpmnElement="Task_Report">
        <dc:Bounds x="2160" y="360" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Task_Review">
        <dc:Bounds x="2340" y="115" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SuccessEnd" bpmnElement="End_Success">
        <dc:Bounds x="2540" y="140" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2500" y="180" width="116" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Start_Criteria" bpmnElement="Flow_Start_Criteria">
        <di:waypoint x="206" y="158" /><di:waypoint x="250" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Criteria_Validate" bpmnElement="Flow_Criteria_Validate">
        <di:waypoint x="370" y="155" /><di:waypoint x="395" y="155" /><di:waypoint x="395" y="400" /><di:waypoint x="420" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Validate_ProfileValid" bpmnElement="Flow_Validate_ProfileValid">
        <di:waypoint x="550" y="400" /><di:waypoint x="590" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Profile_Valid" bpmnElement="Flow_Profile_Valid">
        <di:waypoint x="640" y="400" /><di:waypoint x="700" y="400" />
        <bpmndi:BPMNLabel><dc:Bounds x="660" y="378" width="20" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Profile_Invalid" bpmnElement="Flow_Profile_Invalid">
        <di:waypoint x="615" y="375" /><di:waypoint x="615" y="241" />
        <bpmndi:BPMNLabel><dc:Bounds x="620" y="290" width="32" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Select_LoginNeeded" bpmnElement="Flow_Select_LoginNeeded">
        <di:waypoint x="830" y="400" /><di:waypoint x="870" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Login_Needed" bpmnElement="Flow_Login_Needed">
        <di:waypoint x="895" y="375" /><di:waypoint x="895" y="155" /><di:waypoint x="965" y="155" />
        <bpmndi:BPMNLabel><dc:Bounds x="900" y="210" width="20" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Login_NotNeeded" bpmnElement="Flow_Login_NotNeeded">
        <di:waypoint x="895" y="425" /><di:waypoint x="895" y="485" /><di:waypoint x="1285" y="485" /><di:waypoint x="1285" y="425" />
        <bpmndi:BPMNLabel><dc:Bounds x="1045" y="464" width="32" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Login_SaveSession" bpmnElement="Flow_Login_SaveSession">
        <di:waypoint x="1085" y="155" /><di:waypoint x="1097" y="155" /><di:waypoint x="1097" y="400" /><di:waypoint x="1110" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SaveSession_Merge" bpmnElement="Flow_SaveSession_Merge">
        <di:waypoint x="1230" y="400" /><di:waypoint x="1260" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Merge_Prepare" bpmnElement="Flow_Merge_Prepare">
        <di:waypoint x="1310" y="400" /><di:waypoint x="1360" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Prepare_Query" bpmnElement="Flow_Prepare_Query">
        <di:waypoint x="1490" y="400" /><di:waypoint x="1510" y="400" /><di:waypoint x="1510" y="660" /><di:waypoint x="1530" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Query_Aggregate" bpmnElement="Flow_Query_Aggregate">
        <di:waypoint x="1660" y="660" /><di:waypoint x="1680" y="660" /><di:waypoint x="1680" y="400" /><di:waypoint x="1700" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Aggregate_SourceSuccessful" bpmnElement="Flow_Aggregate_SourceSuccessful">
        <di:waypoint x="1830" y="400" /><di:waypoint x="1870" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Source_None" bpmnElement="Flow_Source_None">
        <di:waypoint x="1895" y="375" /><di:waypoint x="1895" y="155" /><di:waypoint x="1970" y="155" />
        <bpmndi:BPMNLabel><dc:Bounds x="1900" y="220" width="32" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Errors_End" bpmnElement="Flow_Errors_End">
        <di:waypoint x="2090" y="155" /><di:waypoint x="2150" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Source_Success" bpmnElement="Flow_Source_Success">
        <di:waypoint x="1920" y="400" /><di:waypoint x="1980" y="400" />
        <bpmndi:BPMNLabel><dc:Bounds x="1940" y="378" width="20" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Score_Report" bpmnElement="Flow_Score_Report">
        <di:waypoint x="2110" y="400" /><di:waypoint x="2160" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Report_Review" bpmnElement="Flow_Report_Review">
        <di:waypoint x="2290" y="400" /><di:waypoint x="2315" y="400" /><di:waypoint x="2315" y="155" /><di:waypoint x="2340" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Review_End" bpmnElement="Flow_Review_End">
        <di:waypoint x="2460" y="155" /><di:waypoint x="2540" y="158" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
