{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jobsuchprofil",
  "description": "Vorgegebenes Bewerberprofil, gegen das Stellenangebote bewertet werden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "suchbegriffe", "skills_pflicht"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "suchbegriffe": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "skills_pflicht": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "skills_wunsch": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "orte": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "arbeitsmodelle": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "gehalt_min": {"type": "integer", "minimum": 0},
    "gehalt_max": {"type": "integer", "minimum": 0},
    "sprachen": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "min_erfahrung_jahre": {"type": "integer", "minimum": 0},
    "min_pflicht_skills": {
      "description": "Mindestanzahl Pflicht-Skills, die ein Angebot aufweisen muss (Standard: alle).",
      "type": "integer",
      "minimum": 1
    }
  }
}
